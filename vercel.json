{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/holding",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/holding", "permanent": false },
    { "source": "/index.html", "destination": "/holding", "permanent": false },
    { "source": "/watch", "destination": "/holding", "permanent": false },
    { "source": "/listen", "destination": "/holding", "permanent": false },
    { "source": "/read", "destination": "/holding", "permanent": false },
    { "source": "/app", "destination": "/holding", "permanent": false },
    { "source": "/about", "destination": "/holding", "permanent": false },
    { "source": "/cfi", "destination": "/holding", "permanent": false },
    { "source": "/support", "destination": "/holding", "permanent": false },
    { "source": "/legal", "destination": "/holding", "permanent": false },
    { "source": "/empyrean", "destination": "/holding", "permanent": false },
    { "source": "/podcast", "destination": "/holding", "permanent": false },
    { "source": "/download/(.*)", "destination": "/holding", "permanent": false }
  ]
}
